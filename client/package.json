{
  "name": "snipare",
  "displayName": "SnipShare",
  "description": "Extension that enables real-time sharing of selected code or files directly between users' editors.",
  "version": "2.1.0",
  "publisher": "Yogesh-dev9",
  "engines": {
    "vscode": "^1.30.0"
  },
  "icon": "assets/icon.png",
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration":{
      "title": "Servre Data",
      "properties": {
        "snipare.URL":{"type":"string","description": "Server URL","default": "https://snipshareserver-y504.onrender.com"},
        "snipare.tokenURL":{"type":"string","description": "URL to generate tokenURL","default": "https://snipshareserver-y504.onrender.com/generate_token"},
        "snipare.makeFriendURL":{"type":"string","description": "URL to make Friend","default": "https://snipshareserver-y504.onrender.com/engage"}
      }
    },
    "commands": [
      {
        "command": "snipare.sendFile",
        "title": "Send File",
        "icon": {
          "dark": "assets/darkSend.svg",
          "light": "assets/send.svg"
        }
      },
      {
        "command": "snipare.sendCode",
        "title": "Send Code"
      },
      {
        "command": "snipare.changeName",
        "title": "Change Name"
      },
      {
        "command": "snipare.makeFriend",
        "title": "Add Friends",
        "icon": {
          "dark": "assets/darkFriend.svg",
          "light": "assets/lightFriend.svg"
        }
      },
      {
        "command": "snipare.blockFriend",
        "title": "🚫 Block Friend"
      },
      {
        "command": "snipare.unblockFriend",
        "title": "🟢 Unblock Friend"
      }
    ],
    "keybindings": [
      {
        "command": "snipare.sendFile",
        "key": "ctrl+alt+r"
      },
      {
        "command": "snipare.sendCode",
        "key": "ctrl+alt+up"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "snipare.sendFile",
          "when": "editorTextFocus",
          "group": "navigation@1"
        }
      ],
      "editor/title/run": [
        {
          "command": "snipare.makeFriend",
          "group": "navigation"
        },
        {
          "command": "snipare.sendCode",
          "when": "editorTextFocus",
          "group": "navigation"
        }
      ]
    }
  },
  "homepage": "https://snipshare.yolab.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/its-Yogesh123/snipShare.git"
  },
  "bugs": {
    "url": "https://snipshare.yolab.in"
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.30.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.23.0"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "dotenv": "^17.2.3",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.1.0"
  }
}
